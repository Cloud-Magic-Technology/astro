---
import Layout from '../../layouts/Layout.astro';
import CodeBlock from '../../components/shared/CodeBlock.astro';
import AnimatedNumber from '../../components/shared/AnimatedNumber.svelte';

import v5 from '../../../benchmarks/v5-baseline.json';
import v7 from '../../../benchmarks/v7-baseline.json';

const buildImprovement = ((1 - v7.builds.median_ms / v5.builds.median_ms) * 100).toFixed(1);
const distImprovement = ((1 - v7.output.dist_size_bytes / v5.output.dist_size_bytes) * 100).toFixed(1);

const gotchas = [
	{
		title: 'Self-closing non-void elements',
		bad: '<div class="container" />',
		good: '<div class="container"></div>',
		desc: 'The Rust compiler rejects self-closing tags on non-void elements. Only void elements like <img />, <br />, <input /> can self-close.',
	},
	{
		title: 'Unterminated attributes',
		bad: '<div class="foo bar>content</div>',
		good: '<div class="foo bar">content</div>',
		desc: 'Missing closing quotes on attributes are now a hard error, not silently fixed.',
	},
	{
		title: 'Whitespace between inline elements',
		bad: '<span>A</span>\n<span>B</span>  <!-- renders as "AB" not "A B" -->',
		good: '<span>A</span> <span>B</span>  <!-- explicit space preserved -->',
		desc: 'Newlines between inline elements no longer produce a space character. Add explicit spaces where needed.',
	},
];
---

<Layout title="Rust Pipeline | Astro Lab" description="Astro 7 Rust compiler and Sätteri markdown pipeline benchmarks">
	<div class="space-y-8">
		<header class="text-center">
			<span class="inline-block rounded-full bg-purple-500/20 px-3 py-1 text-sm font-medium text-purple-400 mb-4">Astro 7</span>
			<h1 class="text-4xl font-bold text-white mb-3">Rust Pipeline</h1>
			<p class="text-lg text-slate-400 max-w-2xl mx-auto">
				Astro 7 ships a Rust-based compiler (oxc + Lightning CSS) and the Sätteri Rust markdown pipeline.
				Real benchmarks from this repo, not marketing claims.
			</p>
		</header>

		<section class="grid gap-4 md:grid-cols-4">
			<div class="rounded-xl border border-slate-700 bg-slate-800 p-5 text-center">
				<p class="text-sm text-slate-400 mb-1">Build Time (v5)</p>
				<p class="text-3xl font-bold text-slate-500">
					<AnimatedNumber client:visible value={v5.builds.median_ms / 1000} decimals={1} suffix="s" />
				</p>
			</div>
			<div class="rounded-xl border border-purple-500/30 bg-purple-500/10 p-5 text-center">
				<p class="text-sm text-purple-400 mb-1">Build Time (v7)</p>
				<p class="text-3xl font-bold text-purple-400">
					<AnimatedNumber client:visible value={v7.builds.median_ms / 1000} decimals={1} suffix="s" />
				</p>
			</div>
			<div class="rounded-xl border border-green-500/30 bg-green-500/10 p-5 text-center">
				<p class="text-sm text-green-400 mb-1">Build Faster</p>
				<p class="text-3xl font-bold text-green-400">
					<AnimatedNumber client:visible value={parseFloat(buildImprovement)} decimals={1} suffix="%" />
				</p>
			</div>
			<div class="rounded-xl border border-blue-500/30 bg-blue-500/10 p-5 text-center">
				<p class="text-sm text-blue-400 mb-1">Output Smaller</p>
				<p class="text-3xl font-bold text-blue-400">
					<AnimatedNumber client:visible value={parseFloat(distImprovement)} decimals={1} suffix="%" />
				</p>
			</div>
		</section>

		<section class="rounded-xl border border-slate-700 bg-slate-800 p-6">
			<h2 class="text-xl font-bold text-white mb-4">Build Comparison: This Repo</h2>
			<p class="text-sm text-slate-400 mb-4">
				Median of 3 builds on Node {v7.node}, measured {v7.measured}.
			</p>
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-slate-700">
							<th class="py-2 text-left text-slate-400">Metric</th>
							<th class="py-2 text-right text-slate-400">v5 ({v5.version})</th>
							<th class="py-2 text-right text-purple-400">v7 ({v7.version})</th>
							<th class="py-2 text-right text-green-400">Change</th>
						</tr>
					</thead>
					<tbody>
						<tr class="border-b border-slate-700/50">
							<td class="py-2 text-white">Build time</td>
							<td class="py-2 text-right font-mono text-slate-300">{(v5.builds.median_ms / 1000).toFixed(1)}s</td>
							<td class="py-2 text-right font-mono text-purple-300">{(v7.builds.median_ms / 1000).toFixed(1)}s</td>
							<td class="py-2 text-right font-mono text-green-400">-{buildImprovement}%</td>
						</tr>
						<tr class="border-b border-slate-700/50">
							<td class="py-2 text-white">dist/ size</td>
							<td class="py-2 text-right font-mono text-slate-300">{(v5.output.dist_size_bytes / 1024).toFixed(0)} KB</td>
							<td class="py-2 text-right font-mono text-purple-300">{(v7.output.dist_size_bytes / 1024).toFixed(0)} KB</td>
							<td class="py-2 text-right font-mono text-green-400">-{distImprovement}%</td>
						</tr>
						<tr class="border-b border-slate-700/50">
							<td class="py-2 text-white">Client JS</td>
							<td class="py-2 text-right font-mono text-slate-300">{(v5.output.client_js_bytes / 1024).toFixed(1)} KB</td>
							<td class="py-2 text-right font-mono text-purple-300">{(v7.output.client_js_bytes / 1024).toFixed(1)} KB</td>
							<td class="py-2 text-right font-mono text-green-400">-{((1 - v7.output.client_js_bytes / v5.output.client_js_bytes) * 100).toFixed(1)}%</td>
						</tr>
						<tr>
							<td class="py-2 text-white">HTML pages</td>
							<td class="py-2 text-right font-mono text-slate-300">{v5.output.html_pages}</td>
							<td class="py-2 text-right font-mono text-purple-300">{v7.output.html_pages}</td>
							<td class="py-2 text-right font-mono text-slate-400">+{v7.output.html_pages - v5.output.html_pages}</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<section class="rounded-xl border border-slate-700 bg-slate-800 p-6">
			<h2 class="text-xl font-bold text-white mb-4">What Changed Under the Hood</h2>
			<div class="grid gap-4 md:grid-cols-2">
				<div class="rounded-lg bg-slate-900 p-4">
					<h3 class="font-semibold text-purple-400 mb-2">Rust Compiler (oxc)</h3>
					<p class="text-sm text-slate-400">
						The template compiler moved from a JavaScript-based parser to oxc (Rust).
						Lightning CSS replaces the JS CSS pipeline. ~6% build improvement in isolation
						on large sites, but the real gains come from the full pipeline.
					</p>
				</div>
				<div class="rounded-lg bg-slate-900 p-4">
					<h3 class="font-semibold text-purple-400 mb-2">Sätteri Markdown</h3>
					<p class="text-sm text-slate-400">
						The remark/rehype JS markdown pipeline is replaced by Sätteri, a Rust-based
						markdown and MDX processor. Markdown-heavy sites see the biggest gains —
						Astro docs and Cloudflare docs saved over a minute per build.
					</p>
				</div>
				<div class="rounded-lg bg-slate-900 p-4">
					<h3 class="font-semibold text-purple-400 mb-2">Vite 8 + Rolldown</h3>
					<p class="text-sm text-slate-400">
						esbuild is replaced by Rolldown (Rust-based bundler). Faster dependency
						optimization and module transformation across the board.
					</p>
				</div>
				<div class="rounded-lg bg-slate-900 p-4">
					<h3 class="font-semibold text-purple-400 mb-2">Queued Rendering</h3>
					<p class="text-sm text-slate-400">
						Pages render via a queue instead of recursive descent. Early benchmarks
						show ~2.4x faster rendering. Now the default — no flag needed.
					</p>
				</div>
			</div>
		</section>

		<section class="space-y-4">
			<h2 class="text-xl font-bold text-white">Strict HTML Gotchas</h2>
			<p class="text-slate-400">
				The Rust compiler is stricter about HTML validity. Here are common patterns
				that break and their fixes:
			</p>
			{gotchas.map((g) => (
				<div class="rounded-xl border border-slate-700 bg-slate-800 p-5">
					<h3 class="font-semibold text-amber-400 mb-2">{g.title}</h3>
					<p class="text-sm text-slate-400 mb-3">{g.desc}</p>
					<div class="grid gap-3 md:grid-cols-2">
						<div>
							<span class="text-xs font-semibold text-red-400 uppercase">Before (breaks)</span>
							<pre class="mt-1 rounded bg-red-500/10 border border-red-500/20 p-3 text-sm font-mono text-red-300 overflow-x-auto">{g.bad}</pre>
						</div>
						<div>
							<span class="text-xs font-semibold text-green-400 uppercase">After (fixed)</span>
							<pre class="mt-1 rounded bg-green-500/10 border border-green-500/20 p-3 text-sm font-mono text-green-300 overflow-x-auto">{g.good}</pre>
						</div>
					</div>
				</div>
			))}
		</section>

		<section class="rounded-xl border border-slate-700 bg-slate-800 p-6">
			<h2 class="text-xl font-bold text-white mb-3">Official Astro 7 vs 6 Benchmarks</h2>
			<p class="text-sm text-slate-400 mb-4">
				From the <a href="https://astro.build/blog/astro-7/" class="text-purple-400 hover:underline">Astro 7 release blog</a>.
				15-61% faster builds across large production sites:
			</p>
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-slate-700">
							<th class="py-2 text-left text-slate-400">Site</th>
							<th class="py-2 text-right text-slate-400">Pages</th>
							<th class="py-2 text-right text-slate-400">v6</th>
							<th class="py-2 text-right text-purple-400">v7</th>
							<th class="py-2 text-right text-green-400">Faster</th>
						</tr>
					</thead>
					<tbody>
						<tr class="border-b border-slate-700/50">
							<td class="py-2 text-white">docs.astro.build</td>
							<td class="py-2 text-right text-slate-300">6,313</td>
							<td class="py-2 text-right font-mono text-slate-300">114.5s</td>
							<td class="py-2 text-right font-mono text-purple-300">73.5s</td>
							<td class="py-2 text-right font-mono text-green-400">35.8%</td>
						</tr>
						<tr class="border-b border-slate-700/50">
							<td class="py-2 text-white">astro.build</td>
							<td class="py-2 text-right text-slate-300">308</td>
							<td class="py-2 text-right font-mono text-slate-300">62.7s</td>
							<td class="py-2 text-right font-mono text-purple-300">24.2s</td>
							<td class="py-2 text-right font-mono text-green-400">61.3%</td>
						</tr>
						<tr class="border-b border-slate-700/50">
							<td class="py-2 text-white">developers.cloudflare.com</td>
							<td class="py-2 text-right text-slate-300">8,431</td>
							<td class="py-2 text-right font-mono text-slate-300">386.9s</td>
							<td class="py-2 text-right font-mono text-purple-300">261.9s</td>
							<td class="py-2 text-right font-mono text-green-400">32.3%</td>
						</tr>
						<tr class="border-b border-slate-700/50">
							<td class="py-2 text-white">tauri.app</td>
							<td class="py-2 text-right text-slate-300">7,117</td>
							<td class="py-2 text-right font-mono text-slate-300">86.1s</td>
							<td class="py-2 text-right font-mono text-purple-300">55.3s</td>
							<td class="py-2 text-right font-mono text-green-400">35.7%</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>
	</div>
</Layout>

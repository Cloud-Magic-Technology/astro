---
import Layout from '../../layouts/Layout.astro';
import CodeBlock from '../../components/shared/CodeBlock.astro';

const fetchSource = `import { FetchState, astro } from 'astro/fetch';

export default {
  async fetch(request: Request): Promise<Response> {
    const start = performance.now();
    const state = new FetchState(request);

    const response = await astro(state);

    const duration = (performance.now() - start).toFixed(2);
    response.headers.set('X-Response-Time', \`\${duration}ms\`);
    response.headers.set('X-Powered-By', 'Astro-Lab');

    const url = new URL(request.url);
    console.log(JSON.stringify({
      method: request.method,
      path: url.pathname,
      status: response.status,
      duration_ms: parseFloat(duration),
    }));

    return response;
  },
};`;

const composableSource = `import { FetchState, actions, middleware, pages } from 'astro/fetch';

export default {
  async fetch(request: Request): Promise<Response> {
    const state = new FetchState(request);

    // 1. Handle Astro Actions first
    const actionResponse = await actions(state);
    if (actionResponse) return actionResponse;

    // 2. Auth check before rendering
    const url = new URL(request.url);
    if (url.pathname.startsWith('/dashboard')) {
      const cookie = request.headers.get('cookie') ?? '';
      if (!cookie.includes('session=')) {
        return new Response(null, {
          status: 302,
          headers: { Location: '/login' },
        });
      }
    }

    // 3. Render through middleware → pages
    return middleware(state, (s) => pages(s));
  },
};`;
---

<Layout title="Advanced Routing | Astro Lab" description="src/fetch.ts pipeline composition in Astro 7">
	<div class="space-y-8">
		<header class="text-center">
			<span class="inline-block rounded-full bg-purple-500/20 px-3 py-1 text-sm font-medium text-purple-400 mb-4">Astro 7</span>
			<h1 class="text-4xl font-bold text-white mb-3">Advanced Routing</h1>
			<p class="text-lg text-slate-400 max-w-2xl mx-auto">
				Astro 7 introduces <code class="text-purple-400 font-mono">src/fetch.ts</code> — a composable request pipeline
				that follows the Web Fetch standard, compatible with Cloudflare Workers, Bun, and Hono.
			</p>
		</header>

		<section class="rounded-xl border border-slate-700 bg-slate-800 p-6">
			<h2 class="text-xl font-bold text-white mb-4">How It Works</h2>
			<div class="grid gap-6 md:grid-cols-3">
				<div class="rounded-lg bg-slate-900 p-4">
					<div class="text-2xl mb-2">1</div>
					<h3 class="font-semibold text-white mb-1">Request enters</h3>
					<p class="text-sm text-slate-400">Every incoming request passes through your <code class="text-purple-400 font-mono">src/fetch.ts</code> handler</p>
				</div>
				<div class="rounded-lg bg-slate-900 p-4">
					<div class="text-2xl mb-2">2</div>
					<h3 class="font-semibold text-white mb-1">Pipeline executes</h3>
					<p class="text-sm text-slate-400">Pre-processing, auth checks, timing — then delegate to <code class="text-purple-400 font-mono">astro(state)</code></p>
				</div>
				<div class="rounded-lg bg-slate-900 p-4">
					<div class="text-2xl mb-2">3</div>
					<h3 class="font-semibold text-white mb-1">Response returns</h3>
					<p class="text-sm text-slate-400">Post-process the response: add headers, log metrics, transform output</p>
				</div>
			</div>
		</section>

		<section class="space-y-4">
			<h2 class="text-xl font-bold text-white">This Site's Fetch Pipeline</h2>
			<p class="text-slate-400">
				This is the actual <code class="font-mono text-purple-400">src/fetch.ts</code> running on this site right now.
				Check the response headers of any page — you'll see <code class="font-mono text-green-400">X-Response-Time</code>
				and <code class="font-mono text-green-400">X-Powered-By</code>.
			</p>
			<CodeBlock title="src/fetch.ts" lang="typescript">
				{fetchSource}
			</CodeBlock>
		</section>

		<section class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-6">
			<h2 class="text-xl font-bold text-amber-300 mb-3">Live Proof</h2>
			<p class="text-slate-300 mb-4">
				Open your browser's DevTools, go to the Network tab, and click on any page request.
				In the response headers you'll find:
			</p>
			<div class="grid gap-3 md:grid-cols-2">
				<div class="rounded-lg bg-slate-800 p-3 font-mono text-sm">
					<span class="text-slate-400">X-Response-Time:</span> <span class="text-green-400">&lt;duration&gt;ms</span>
				</div>
				<div class="rounded-lg bg-slate-800 p-3 font-mono text-sm">
					<span class="text-slate-400">X-Powered-By:</span> <span class="text-green-400">Astro-Lab</span>
				</div>
			</div>
		</section>

		<section class="space-y-4">
			<h2 class="text-xl font-bold text-white">Composable Handlers</h2>
			<p class="text-slate-400">
				For granular control, import individual handlers and compose them in any order.
				This example puts an auth check <em>before</em> page rendering:
			</p>
			<CodeBlock title="src/fetch.ts (composable pattern)" lang="typescript">
				{composableSource}
			</CodeBlock>
		</section>

		<section class="rounded-xl border border-slate-700 bg-slate-800 p-6">
			<h2 class="text-xl font-bold text-white mb-3">Key Concepts</h2>
			<dl class="space-y-4">
				<div>
					<dt class="font-semibold text-purple-400">Fetchable interface</dt>
					<dd class="text-slate-400 text-sm mt-1">An object with a <code class="font-mono">fetch(request: Request): Promise&lt;Response&gt;</code> method — the same shape used by Cloudflare Workers, Bun, and Hono.</dd>
				</div>
				<div>
					<dt class="font-semibold text-purple-400">FetchState</dt>
					<dd class="text-slate-400 text-sm mt-1">Wraps a Request with Astro-specific context. Pass it to <code class="font-mono">astro()</code>, <code class="font-mono">pages()</code>, <code class="font-mono">middleware()</code>, or <code class="font-mono">actions()</code>.</dd>
				</div>
				<div>
					<dt class="font-semibold text-purple-400">No middleware.ts needed</dt>
					<dd class="text-slate-400 text-sm mt-1"><code class="font-mono">src/fetch.ts</code> subsumes middleware — you control exactly where in the pipeline each concern runs.</dd>
				</div>
			</dl>
		</section>
	</div>
</Layout>

---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import CodeBlock from '../../components/shared/CodeBlock.astro';

const oldPattern = `// Astro 5 / Cloudflare adapter < 14
// Access bindings via Astro.locals.runtime
const runtime = Astro.locals.runtime;
const env = runtime.env;
const kv = env.MY_KV;
await kv.put('key', 'value');`;

const newPattern = `// Astro 7 / Cloudflare adapter 14+
// Direct module import — works in dev (workerd) and production
import { env } from 'cloudflare:workers';
const kv = env.SHOWCASE_KV;
await kv.put('key', 'value');`;

const wranglerConfig = `// wrangler.jsonc
{
  "kv_namespaces": [
    {
      "binding": "SHOWCASE_KV",
      "id": "c36ff3ab...",
      "preview_id": "19513d4f..."
    }
  ]
}`;

const apiRoute = `// src/pages/api/kv-demo.ts
import type { APIRoute } from 'astro';
import { env } from 'cloudflare:workers';

export const POST: APIRoute = async ({ request }) => {
  const { key, value } = await request.json();
  const kv = env.SHOWCASE_KV as KVNamespace;
  await kv.put(key, value);
  return Response.json({ ok: true, key, value });
};

export const GET: APIRoute = async ({ url }) => {
  const key = url.searchParams.get('key');
  if (!key) return Response.json({ error: 'key required' }, { status: 400 });
  const kv = env.SHOWCASE_KV as KVNamespace;
  const value = await kv.get(key);
  return Response.json({ key, value, found: value !== null });
};`;
---

<Layout title="Platform Parity | Astro Lab" description="Cloudflare KV working identically in dev and production">
	<div class="space-y-8">
		<header class="text-center">
			<span class="inline-block rounded-full bg-blue-500/20 px-3 py-1 text-sm font-medium text-blue-400 mb-4">Astro 6</span>
			<h1 class="text-4xl font-bold text-white mb-3">Platform Parity</h1>
			<p class="text-lg text-slate-400 max-w-2xl mx-auto">
				Astro 6's Cloudflare adapter runs <code class="font-mono text-blue-400">workerd</code> in dev,
				giving you identical behavior in development and production. No more "works on my machine."
			</p>
		</header>

		<section class="rounded-xl border border-slate-700 bg-slate-800 p-6">
			<h2 class="text-xl font-bold text-white mb-4">The Old Way vs The New Way</h2>
			<div class="grid gap-4 md:grid-cols-2">
				<div>
					<span class="text-xs font-semibold text-red-400 uppercase mb-2 block">Before (Astro 5)</span>
					<CodeBlock title="Astro.locals.runtime" lang="typescript">
						{oldPattern}
					</CodeBlock>
				</div>
				<div>
					<span class="text-xs font-semibold text-green-400 uppercase mb-2 block">After (Astro 6+)</span>
					<CodeBlock title="cloudflare:workers" lang="typescript">
						{newPattern}
					</CodeBlock>
				</div>
			</div>
		</section>

		<section class="rounded-xl border border-green-500/30 bg-green-500/10 p-6">
			<h2 class="text-xl font-bold text-green-300 mb-3">What Changed</h2>
			<div class="space-y-4">
				<div class="flex items-start gap-3">
					<span class="mt-1 inline-block h-2 w-2 rounded-full bg-green-400"></span>
					<div>
						<span class="font-medium text-white">Module-based imports</span>
						<p class="text-sm text-slate-400">
							<code class="font-mono">import {"{ env }"} from 'cloudflare:workers'</code> replaces
							the runtime-injected <code class="font-mono">Astro.locals.runtime.env</code> pattern.
							The import is static, type-safe, and works at the module level.
						</p>
					</div>
				</div>
				<div class="flex items-start gap-3">
					<span class="mt-1 inline-block h-2 w-2 rounded-full bg-green-400"></span>
					<div>
						<span class="font-medium text-white">workerd in dev</span>
						<p class="text-sm text-slate-400">
							The dev server now runs your code inside the actual Workers runtime (workerd),
							not a Node.js polyfill. KV, R2, D1, Durable Objects, and Queues all behave
							identically in <code class="font-mono">npm run dev</code> and production.
						</p>
					</div>
				</div>
				<div class="flex items-start gap-3">
					<span class="mt-1 inline-block h-2 w-2 rounded-full bg-green-400"></span>
					<div>
						<span class="font-medium text-white">No more runtime checks</span>
						<p class="text-sm text-slate-400">
							Gone: <code class="font-mono">if (import.meta.env.DEV) ... else ...</code> branching
							for dev vs prod bindings. The same code path runs everywhere.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="space-y-4">
			<h2 class="text-xl font-bold text-white">KV Demo: API Route</h2>
			<p class="text-slate-400">
				This site has a real Cloudflare KV namespace (<code class="font-mono text-purple-400">SHOWCASE_KV</code>)
				bound in <code class="font-mono">wrangler.jsonc</code>. The API route below uses it via the
				<code class="font-mono text-blue-400">cloudflare:workers</code> import:
			</p>
			<CodeBlock title="src/pages/api/kv-demo.ts" lang="typescript">
				{apiRoute}
			</CodeBlock>
		</section>

		<section class="space-y-4">
			<h2 class="text-xl font-bold text-white">Wrangler Configuration</h2>
			<p class="text-slate-400">
				KV namespaces are declared in <code class="font-mono text-purple-400">wrangler.jsonc</code>.
				The <code class="font-mono">preview_id</code> is used in local dev (via workerd):
			</p>
			<CodeBlock title="wrangler.jsonc" lang="json">
				{wranglerConfig}
			</CodeBlock>
		</section>

		<section class="rounded-xl border border-slate-700 bg-slate-800 p-6">
			<h2 class="text-xl font-bold text-white mb-4">Available Bindings</h2>
			<p class="text-slate-400 mb-4">
				All Cloudflare Workers bindings work with the same import pattern:
			</p>
			<div class="grid gap-3 md:grid-cols-2">
				<div class="rounded-lg bg-slate-900 p-3">
					<span class="font-semibold text-purple-400">KV Namespace</span>
					<p class="text-sm text-slate-400 font-mono mt-1">env.MY_KV as KVNamespace</p>
				</div>
				<div class="rounded-lg bg-slate-900 p-3">
					<span class="font-semibold text-purple-400">R2 Bucket</span>
					<p class="text-sm text-slate-400 font-mono mt-1">env.MY_BUCKET as R2Bucket</p>
				</div>
				<div class="rounded-lg bg-slate-900 p-3">
					<span class="font-semibold text-purple-400">D1 Database</span>
					<p class="text-sm text-slate-400 font-mono mt-1">env.MY_DB as D1Database</p>
				</div>
				<div class="rounded-lg bg-slate-900 p-3">
					<span class="font-semibold text-purple-400">Durable Objects</span>
					<p class="text-sm text-slate-400 font-mono mt-1">env.MY_DO as DurableObjectNamespace</p>
				</div>
			</div>
		</section>
	</div>
</Layout>

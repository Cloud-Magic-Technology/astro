---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

import v5 from '../../benchmarks/v5-baseline.json';
import v7 from '../../benchmarks/v7-baseline.json';

const posts = await getCollection('blog');
const recentPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const buildImprovement = ((1 - v7.builds.median_ms / v5.builds.median_ms) * 100).toFixed(0);

const v7Features = [
	{ href: '/v7/advanced-routing', title: 'Advanced Routing', desc: 'src/fetch.ts pipeline composition' },
	{ href: '/v7/route-caching', title: 'Route Caching', desc: 'CDN cache with Cloudflare provider' },
	{ href: '/v7/rust-pipeline', title: 'Rust Pipeline', desc: 'Compiler & Sätteri benchmarks' },
	{ href: '/v7/agent-dev', title: 'Agent Dev', desc: 'AI-native dev server' },
];

const v6Features = [
	{ href: '/v6/live-content', title: 'Live Content', desc: 'Request-time collections' },
	{ href: '/v6/platform-parity', title: 'Platform Parity', desc: 'Cloudflare dev/prod unity' },
];

const coreDemos = [
	{ href: '/playground', title: 'Playground', desc: 'Hydration strategies' },
	{ href: '/state-sharing', title: 'State Sharing', desc: 'Cross-framework cart' },
	{ href: '/transitions', title: 'Transitions', desc: 'View Transitions API' },
	{ href: '/server-islands', title: 'Server Islands', desc: 'Static + dynamic mixing' },
	{ href: '/api-demo', title: 'API Demo', desc: 'Server endpoints' },
	{ href: '/content-power', title: 'Content Power', desc: 'MDX & Collections' },
];
---

<Layout title="Astro Lab | Power & Evolution Showcase" description="One codebase, three major versions, every feature proven live.">
	<div class="space-y-16">
		<!-- Hero -->
		<header class="text-center py-8">
			<h1 class="text-5xl font-bold text-white mb-4 md:text-6xl">
				<span class="bg-gradient-to-r from-purple-400 via-blue-400 to-green-400 bg-clip-text text-transparent">Astro Lab</span>
			</h1>
			<p class="text-xl text-slate-300 max-w-2xl mx-auto mb-2">
				One codebase. Three major versions. Every feature, proven live.
			</p>
			<p class="text-sm text-slate-500">
				v5 → v6 → v7 &middot; React + Vue + Svelte &middot; Cloudflare Workers
			</p>
		</header>

		<!-- Three Acts -->
		<section class="grid gap-6 md:grid-cols-3">
			<!-- Act I: Evolution -->
			<a href="/evolution" class="group rounded-xl border border-slate-700 bg-slate-800/50 p-6 transition-all hover:border-blue-500/50 hover:shadow-lg hover:shadow-blue-500/10">
				<span class="text-xs font-semibold text-blue-400 uppercase tracking-wider">Act I</span>
				<h2 class="text-2xl font-bold text-white mt-2 mb-3 group-hover:text-blue-400 transition-colors">The Evolution</h2>
				<p class="text-slate-400 text-sm mb-4">
					How Astro grew from Islands Architecture to a Rust-powered, AI-native framework across three major versions.
				</p>
				<span class="text-sm font-medium text-blue-400">See the timeline &rarr;</span>
			</a>

			<!-- Act II: Features -->
			<div class="rounded-xl border border-slate-700 bg-slate-800/50 p-6">
				<span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">Act II</span>
				<h2 class="text-2xl font-bold text-white mt-2 mb-3">The Features</h2>
				<p class="text-slate-400 text-sm mb-4">
					Live demos proving every major capability — from composable routing to AI-native dev servers.
				</p>
				<div class="space-y-1">
					{v7Features.slice(0, 3).map((f) => (
						<a href={f.href} class="flex items-center justify-between rounded-lg px-2 py-1.5 text-sm transition-colors hover:bg-slate-700">
							<span class="text-slate-300">{f.title}</span>
							<span class="text-xs text-purple-400">v7</span>
						</a>
					))}
					<a href="/v6/live-content" class="flex items-center justify-between rounded-lg px-2 py-1.5 text-sm transition-colors hover:bg-slate-700">
						<span class="text-slate-300">Live Content</span>
						<span class="text-xs text-green-400">v6</span>
					</a>
				</div>
			</div>

			<!-- Act III: Performance -->
			<a href="/performance" class="group rounded-xl border border-slate-700 bg-slate-800/50 p-6 transition-all hover:border-green-500/50 hover:shadow-lg hover:shadow-green-500/10">
				<span class="text-xs font-semibold text-green-400 uppercase tracking-wider">Act III</span>
				<h2 class="text-2xl font-bold text-white mt-2 mb-3 group-hover:text-green-400 transition-colors">The Results</h2>
				<p class="text-slate-400 text-sm mb-4">
					Real benchmarks from this repo. {buildImprovement}% faster builds, measured and verified.
				</p>
				<div class="flex items-baseline gap-2 mb-2">
					<span class="text-3xl font-bold text-green-400">{buildImprovement}%</span>
					<span class="text-sm text-slate-500">faster builds</span>
				</div>
				<span class="text-sm font-medium text-green-400">See all metrics &rarr;</span>
			</a>
		</section>

		<!-- Feature Grid -->
		<section>
			<h2 class="text-lg font-bold text-white mb-4 text-center">All Demo Pages</h2>
			<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{v7Features.map((f) => (
					<a href={f.href} class="flex items-center gap-3 rounded-lg border border-slate-700 bg-slate-800/50 p-3 transition-colors hover:border-purple-500/50">
						<span class="rounded bg-purple-500/20 px-2 py-0.5 text-xs font-semibold text-purple-400">v7</span>
						<div>
							<span class="text-sm font-medium text-white">{f.title}</span>
							<span class="block text-xs text-slate-500">{f.desc}</span>
						</div>
					</a>
				))}
				{v6Features.map((f) => (
					<a href={f.href} class="flex items-center gap-3 rounded-lg border border-slate-700 bg-slate-800/50 p-3 transition-colors hover:border-green-500/50">
						<span class="rounded bg-green-500/20 px-2 py-0.5 text-xs font-semibold text-green-400">v6</span>
						<div>
							<span class="text-sm font-medium text-white">{f.title}</span>
							<span class="block text-xs text-slate-500">{f.desc}</span>
						</div>
					</a>
				))}
				{coreDemos.map((f) => (
					<a href={f.href} class="flex items-center gap-3 rounded-lg border border-slate-700 bg-slate-800/50 p-3 transition-colors hover:border-blue-500/50">
						<span class="rounded bg-blue-500/20 px-2 py-0.5 text-xs font-semibold text-blue-400">v5</span>
						<div>
							<span class="text-sm font-medium text-white">{f.title}</span>
							<span class="block text-xs text-slate-500">{f.desc}</span>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- Recent Posts -->
		{recentPosts.length > 0 && (
			<section>
				<div class="flex items-center justify-between mb-4">
					<h2 class="text-lg font-bold text-white">Recent Posts</h2>
					<a href="/blog" class="text-sm text-purple-400 hover:underline">View all &rarr;</a>
				</div>
				<div class="grid gap-4 md:grid-cols-3">
					{recentPosts.map((post) => (
						<a href={`/blog/${post.id}`} class="rounded-xl border border-slate-700 bg-slate-800/50 p-4 transition-colors hover:border-purple-500/50">
							<h3 class="font-medium text-white mb-1">{post.data.title}</h3>
							<p class="text-sm text-slate-400 line-clamp-2 mb-2">{post.data.description}</p>
							<div class="flex items-center gap-2">
								<time class="text-xs text-slate-500">
									{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
								</time>
								{post.data.tags.slice(0, 2).map((tag) => (
									<span class="rounded bg-slate-700 px-1.5 py-0.5 text-xs text-slate-400">{tag}</span>
								))}
							</div>
						</a>
					))}
				</div>
			</section>
		)}
	</div>
</Layout>

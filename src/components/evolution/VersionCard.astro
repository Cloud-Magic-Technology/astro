---
interface Feature {
	name: string;
	href?: string;
}

interface Props {
	version: string;
	tagline: string;
	color: 'blue' | 'green' | 'purple';
	features: Feature[];
	highlights: string[];
}

const { version, tagline, color, features, highlights } = Astro.props;

const colorClasses = {
	blue: {
		border: 'border-blue-500',
		bg: 'bg-blue-500',
		text: 'text-blue-400',
		glow: 'shadow-blue-500/20',
		dot: 'bg-blue-500',
	},
	green: {
		border: 'border-green-500',
		bg: 'bg-green-500',
		text: 'text-green-400',
		glow: 'shadow-green-500/20',
		dot: 'bg-green-500',
	},
	purple: {
		border: 'border-purple-500',
		bg: 'bg-purple-500',
		text: 'text-purple-400',
		glow: 'shadow-purple-500/20',
		dot: 'bg-purple-500',
	},
};

const c = colorClasses[color];
---

<div class={`relative rounded-xl border ${c.border} bg-slate-800/50 p-6 shadow-lg ${c.glow} transition-all duration-300 hover:scale-[1.02]`}>
	<div class="mb-4 flex items-center justify-between">
		<span class={`rounded-full ${c.bg} px-4 py-1.5 text-lg font-bold text-white`}>
			{version}
		</span>
	</div>

	<p class={`mb-4 text-lg font-semibold ${c.text}`}>{tagline}</p>

	<div class="mb-4">
		<h4 class="mb-2 text-sm font-semibold text-slate-400 uppercase tracking-wider">Key Features</h4>
		<div class="flex flex-wrap gap-2">
			{features.map((f) => (
				f.href ? (
					<a href={f.href} class={`inline-block rounded-lg border border-slate-600 bg-slate-700/50 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:${c.border} hover:${c.text}`}>
						{f.name} &rarr;
					</a>
				) : (
					<span class="inline-block rounded-lg bg-slate-700/50 px-3 py-1.5 text-sm text-slate-300">
						{f.name}
					</span>
				)
			))}
		</div>
	</div>

	<div>
		<h4 class="mb-2 text-sm font-semibold text-slate-400 uppercase tracking-wider">Highlights</h4>
		<ul class="space-y-1">
			{highlights.map((h) => (
				<li class="flex items-start gap-2 text-sm text-slate-300">
					<span class={`mt-1.5 inline-block h-1.5 w-1.5 rounded-full ${c.dot} shrink-0`}></span>
					{h}
				</li>
			))}
		</ul>
	</div>

	<slot />
</div>
